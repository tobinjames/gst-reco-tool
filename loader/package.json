{
  "name": "gst-reco-loader",
  "version": "1.0.0",
  "private": true,
  "description": "James & James GST reconciliation loader: one offline HTML page",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "tsx test/run.ts",
    "test:update": "tsx test/cases.ts --update",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" index.html",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" index.html"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "pdfjs-dist": "^4.10.38"
  }
}
